{
  "name": "workcell-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "pnpm check && astro build",
    "preview": "astro preview",
    "test:e2e": "pnpm build && playwright test",
    "verify:release": "cd .. && GOFLAGS=-mod=readonly make test stringproof-release-asset && cd site && node scripts/verify-release-assets.mjs",
    "deploy": "pnpm verify:release && pnpm build && wrangler pages deploy --branch main"
  },
  "dependencies": {
    "astro": "7.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.0",
    "@types/node": "^26.1.2",
    "typescript": "6.0.3",
    "wrangler": "4.115.0"
  }
}
