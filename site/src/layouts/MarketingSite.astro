---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import faviconUrl from "../assets/favicon.svg?url&no-inline";
import workcellUnfurl from "../assets/workcell-unfurl.png";
import stringproofUnfurl from "../assets/stringproof-unfurl.png";

interface Props {
    title: string;
    description: string;
    product: "workcell" | "stringproof";
    sourceUrl: string;
    agentInstructionsUrl: string;
}

const { title, description, product, sourceUrl, agentInstructionsUrl } = Astro.props;
if (!Astro.site) throw new Error("Astro site URL is required");

const canonical = new URL(Astro.url.pathname, Astro.site);
const agentInstructions = new URL(agentInstructionsUrl, Astro.site);
const unfurlImage =
    product === "workcell" ? workcellUnfurl : stringproofUnfurl;
const unfurl = new URL(unfurlImage.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f9f9f8" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#10131d" media="(prefers-color-scheme: dark)" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="article" />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content={title} />
        <meta property="og:image" content={unfurl} />
        <meta property="og:image:width" content={String(unfurlImage.width)} />
        <meta property="og:image:height" content={String(unfurlImage.height)} />
        <meta property="og:image:alt" content={`${title} — ${description}`} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={unfurl} />
        <link rel="canonical" href={canonical} />
        <link
            rel="alternate"
            type="text/plain"
            href={agentInstructions}
            title={`${title} instructions for language models`}
        />
        <link rel="icon" href={faviconUrl} type="image/svg+xml" />
        <title>{title}</title>
    </head>
    <body>
        <div class="site-page">
            <div class="top-gradient" aria-hidden="true"></div>

            <SiteHeader title={title} product={product} sourceUrl={sourceUrl} />

            <slot />

            <SiteFooter sourceUrl={sourceUrl} agentInstructionsUrl={agentInstructionsUrl} />
        </div>
    </body>
</html>
