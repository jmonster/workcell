---
import NavigationLinks from './NavigationLinks.astro';
import markUrl from '../assets/workcell-mark.svg?url&no-inline';
import chevronUrl from '../assets/icons/chevron-down.svg?url&no-inline';
import authorAvatar from '../assets/johnny-domino.png';

interface Props {
  title: string;
  product: 'workcell' | 'stringproof' | 'playbook' | 'knowledge';
}

const { title, product } = Astro.props;
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="site-logo" href="/" aria-label="Home">
      <img src={markUrl} width="48" height="48" alt="" />
    </a>

    <div class="desktop-navigation">
      <NavigationLinks product={product} />
    </div>

    <details class="mobile-navigation">
      <summary>
        <span>{title}</span>
        <img src={chevronUrl} width="20" height="20" alt="" />
      </summary>
      <div class="mobile-navigation__sheet">
        <NavigationLinks product={product} />
        <div class="mobile-identity-shortcuts">
          <a href="https://wabisabiwar.es/">@work</a>
          <span aria-hidden="true">|</span>
          <a href="https://github.com/jmonster">@jmonster</a>
        </div>
      </div>
    </details>

    <div class="identity-shortcuts">
      <a href="https://wabisabiwar.es/" aria-label="Wabi Sabi Ware">@work</a>
      <span class="identity-separator" aria-hidden="true">|</span>
      <a class="identity-author" href="https://github.com/jmonster" aria-label="@jmonster on GitHub">
        <span>@jmonster</span>
        <img src={authorAvatar.src} width="32" height="32" alt="" />
      </a>
    </div>
  </nav>
</header>
