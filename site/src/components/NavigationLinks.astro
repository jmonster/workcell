---
interface Props {
  product: 'workcell' | 'stringproof' | 'playbook' | 'knowledge';
}

const { product } = Astro.props;
const links = [
  {
    label: 'Playbook',
    href: '/playbook/',
    current: product === 'playbook',
    emphasis: 'secondary',
  },
  {
    label: 'Stringproof',
    href: '/stringproof/',
    current: product === 'stringproof',
    emphasis: 'secondary',
  },
  {
    label: 'Knowledge',
    href: '/knowledge/',
    current: product === 'knowledge',
    emphasis: 'secondary',
  },
  {
    label: 'Workcell',
    href: '/',
    current: product === 'workcell',
    emphasis: 'primary',
  },
];
---

{links.map(({ label, href, current, emphasis }) => (
  <a
    class:list={{
      'is-current': current,
      'is-primary': emphasis === 'primary',
      'is-secondary': emphasis === 'secondary',
      'is-workcell': label === 'Workcell',
    }}
    href={href}
    aria-current={current ? 'page' : undefined}
  >
    {label}
  </a>
))}
