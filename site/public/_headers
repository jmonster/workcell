/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/downloads/*
  Cache-Control: no-store

/downloads/workcell-darwin-arm64
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="workcell-darwin-arm64"

/downloads/workcell-darwin-amd64
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="workcell-darwin-amd64"

/downloads/workcell-linux-arm64
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="workcell-linux-arm64"

/downloads/workcell-linux-amd64
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="workcell-linux-amd64"

/install.sh
  Content-Type: text/x-shellscript; charset=utf-8
  Cache-Control: public, max-age=30, must-revalidate

/demo.sh
  Content-Type: text/x-shellscript; charset=utf-8
  Cache-Control: public, max-age=30, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
